{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad3mf.dev/schemas/job-manifest/0.1.0",
  "title": "CAD3MF Job Manifest 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "trace_id",
    "project_id",
    "job_kind",
    "status",
    "stage",
    "attempt",
    "max_attempts",
    "inputs",
    "outputs",
    "tool_versions",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "idempotency_key": {"type": ["string", "null"], "maxLength": 256},
    "job_kind": {
      "enum": ["visual_analysis", "concept_generation", "turnaround_generation", "geometry_generation", "cad_build", "mesh_repair", "assembly", "validation", "manufacturing_plan", "slicing", "bundle"]
    },
    "status": {"enum": ["queued", "running", "blocked", "succeeded", "failed", "canceled"]},
    "stage": {
      "enum": ["intake", "visual_analysis", "concept", "confirmation", "turnaround", "geometry", "productization", "assembly", "validation", "manufacturing", "slicing", "bundle", "complete"]
    },
    "attempt": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20},
    "blocked_reason_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "error_ref": {"type": ["string", "null"], "maxLength": 256},
    "inputs": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/artifactRef"}
    },
    "outputs": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/artifactRef"}
    },
    "tool_versions": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/toolVersion"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "kind": {"enum": ["source_image", "concept_image", "turnaround_image", "design_intent", "cad_ir", "asset_ir", "assembly_ir", "manufacturing_ir", "mesh", "step", "stl", "generic_3mf", "bambu_3mf", "glb", "report", "manifest", "other"]},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "media_type": {"type": ["string", "null"], "maxLength": 128},
        "revision_ref": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "toolVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "digest": {"type": ["string", "null"], "maxLength": 256}
      }
    }
  }
}