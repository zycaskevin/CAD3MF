{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad3mf.dev/schemas/visual-concept/0.1.0",
  "title": "CAD3MF Visual Concept 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "concept_id",
    "project_id",
    "revision_id",
    "source_intent_revision_id",
    "product_kind",
    "brief",
    "artifacts",
    "design_notes",
    "open_decisions",
    "status",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "concept_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "revision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "parent_revision_id": {"type": ["string", "null"], "maxLength": 128},
    "source_intent_revision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "product_kind": {
      "enum": ["figurine", "character", "modular_product", "vehicle", "mechanical_part", "hybrid", "other"]
    },
    "brief": {"type": "string", "minLength": 1, "maxLength": 4000},
    "style": {"type": ["string", "null"], "maxLength": 256},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/conceptArtifact"}
    },
    "design_notes": {
      "type": "array",
      "maxItems": 128,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "open_decisions": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/decision"}
    },
    "status": {
      "enum": ["draft", "needs_confirmation", "confirmed", "design_locked", "rejected", "superseded"]
    },
    "provenance": {"$ref": "#/$defs/provenance"},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "conceptArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "media_type", "role"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "media_type": {"enum": ["image/png", "image/jpeg", "image/webp"]},
        "role": {"enum": ["hero", "variant", "detail", "reference_composite"]},
        "width_px": {"type": ["integer", "null"], "minimum": 1, "maximum": 16384},
        "height_px": {"type": ["integer", "null"], "minimum": 1, "maximum": 16384}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "required", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 1000},
        "required": {"type": "boolean"},
        "status": {"enum": ["open", "answered", "waived"]},
        "answer": {"type": ["string", "null"], "maxLength": 2000}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_kind", "provider", "model", "job_id", "input_artifact_sha256"],
      "properties": {
        "origin_kind": {"enum": ["provider_generated", "host_provided"]},
        "provider": {"type": ["string", "null"], "maxLength": 128},
        "model": {"type": ["string", "null"], "maxLength": 256},
        "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "input_artifact_sha256": {
          "type": "array",
          "maxItems": 64,
          "items": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        },
        "generated_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}