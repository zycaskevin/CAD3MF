{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad3mf.dev/schemas/robust-repair-report/0.1.0",
  "title": "CAD3MF Robust Repair Report 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "request_id",
    "project_id",
    "source_mesh_artifact_id",
    "source_sha256",
    "output_sha256",
    "backend",
    "reconstruction_budget",
    "input_metrics",
    "output_metrics",
    "fidelity",
    "appearance_rebake_required",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "report_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source_mesh_artifact_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "output_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "backend": {"$ref": "#/$defs/backend"},
    "reconstruction_budget": {"$ref": "#/$defs/reconstructionBudget"},
    "input_metrics": {"$ref": "#/$defs/meshMetrics"},
    "output_metrics": {"oneOf": [{"$ref": "#/$defs/meshMetrics"}, {"type": "null"}]},
    "fidelity": {"oneOf": [{"$ref": "#/$defs/fidelity"}, {"type": "null"}]},
    "appearance_rebake_required": {"const": true},
    "status": {
      "enum": [
        "reconstructed_topology_valid",
        "reconstruction_invalid",
        "rejected_fidelity",
        "backend_unavailable",
        "backend_error"
      ]
    },
    "notes": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "maxLength": 1024}
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_id", "algorithm_id", "version"],
      "properties": {
        "backend_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "algorithm_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "reconstructionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality_tier", "resolution_budget"],
      "properties": {
        "quality_tier": {"enum": ["preview", "standard", "high", "ultra"]},
        "resolution_budget": {"type": "integer", "minimum": 1000, "maximum": 1000000}
      }
    },
    "vec3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "number"}
      }
    },
    "boundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "extents"],
      "properties": {
        "min": {"$ref": "#/$defs/vec3"},
        "max": {"$ref": "#/$defs/vec3"},
        "extents": {"$ref": "#/$defs/vec3"}
      }
    },
    "meshMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vertex_count",
        "triangle_count",
        "component_count",
        "boundary_edge_count",
        "nonmanifold_edge_count",
        "duplicate_face_count",
        "degenerate_face_count",
        "unreferenced_vertex_count",
        "watertight",
        "winding_consistent",
        "bounding_box_mm"
      ],
      "properties": {
        "vertex_count": {"type": "integer", "minimum": 0},
        "triangle_count": {"type": "integer", "minimum": 0},
        "component_count": {"type": "integer", "minimum": 0},
        "boundary_edge_count": {"type": "integer", "minimum": 0},
        "nonmanifold_edge_count": {"type": "integer", "minimum": 0},
        "duplicate_face_count": {"type": "integer", "minimum": 0},
        "degenerate_face_count": {"type": "integer", "minimum": 0},
        "unreferenced_vertex_count": {"type": "integer", "minimum": 0},
        "watertight": {"type": "boolean"},
        "winding_consistent": {"type": "boolean"},
        "bounding_box_mm": {"$ref": "#/$defs/boundingBox"}
      }
    },
    "extentDrift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "max"],
      "properties": {
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "z": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0}
      }
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extent_drift_mm",
        "centroid_drift_mm",
        "sampled_vertex_chamfer_mm",
        "sampled_vertex_hausdorff_mm",
        "sample_count",
        "pass",
        "failed_thresholds"
      ],
      "properties": {
        "extent_drift_mm": {"$ref": "#/$defs/extentDrift"},
        "centroid_drift_mm": {"type": "number", "minimum": 0},
        "sampled_vertex_chamfer_mm": {"type": "number", "minimum": 0},
        "sampled_vertex_hausdorff_mm": {"type": "number", "minimum": 0},
        "sample_count": {"type": "integer", "minimum": 1, "maximum": 8192},
        "pass": {"type": "boolean"},
        "failed_thresholds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 4,
          "items": {
            "enum": [
              "max_extent_drift_mm",
              "max_centroid_drift_mm",
              "max_sampled_vertex_chamfer_mm",
              "max_sampled_vertex_hausdorff_mm"
            ]
          }
        }
      }
    }
  }
}
